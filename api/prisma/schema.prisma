// api/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Rol {
  ADMIN
  LIDER
  SUPERVISOR
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  rol       Rol      @default(LIDER)
  zona_id   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  celulas   Celula[] @relation("LiderDeCelula")
}

model Celula {
  id                   String           @id @default(uuid())
  nombre               String
  lider_id             String
  dia_reunion          String
  hora                 String
  ubicacion_geografica String?
  zona                 String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Relaciones
  lider                User             @relation("LiderDeCelula", fields: [lider_id], references: [id])
  reportes             ReporteSemanal[]
}

model ReporteSemanal {
  id                 String   @id @default(uuid())
  celula_id          String
  fecha              DateTime
  asistencia_adultos Int      @default(0)
  asistencia_ninos   Int      @default(0)
  nuevos_invitados   Int      @default(0)
  peticiones_oracion String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relaciones
  celula             Celula   @relation(fields: [celula_id], references: [id])
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  whatsapp  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriber")
}