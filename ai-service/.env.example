# Puerto del servidor
PORT=4000

# API Keys
DEEPGRAM_API_KEY=your-deepgram-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
NANO_BANANA_API_KEY=your-nano-banana-api-key-here

# URLs de servicios externos
DEEPGRAM_API_URL=https://api.deepgram.com/v1
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
NANO_BANANA_API_URL=https://api.nano-banana.com/v1

# Configuración de audiencia objetivo
TARGET_AUDIENCE=mujeres 25-44 años
TARGET_LANGUAGE=es